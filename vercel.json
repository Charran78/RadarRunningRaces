{
  "version": 2,
  "functions": {
    "src/index.js": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/src/index.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/public/assets/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/public/$1"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/admin/actualizar",
      "schedule": "30 3 * * *"
    }
  ]
}
