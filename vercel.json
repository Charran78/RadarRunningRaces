{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "src/index.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "public/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "public/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/admin/actualizar",
      "schedule": "30 3 * * *"
    }
  ]
}
